{#-
  MADR 3.0 canonical Jinja2 template.
  Source of truth: https://github.com/adr/madr (template/adr-template.md)
  Strict conventions:
    - Consequences use only polarity in {Good, Bad}
    - Pros and Cons use polarity in {Good, Neutral, Bad}
    - Frontmatter field is `decision-makers` (not `deciders`)
-#}
---
{%- if status %}
status: "{{ status }}"
{%- endif %}
{%- if date %}
date: {{ date }}
{%- endif %}
{%- if decision_makers %}
decision-makers: {{ decision_makers }}
{%- endif %}
{%- if consulted %}
consulted: {{ consulted }}
{%- endif %}
{%- if informed %}
informed: {{ informed }}
{%- endif %}
---

# {{ title }}

## Context and Problem Statement

{{ context }}

{% if decision_drivers %}
## Decision Drivers

{% for d in decision_drivers %}* {{ d }}
{% endfor %}
{% endif %}
## Considered Options

{% for o in considered_options %}* {{ o.title }}
{% endfor %}
## Decision Outcome

Chosen option: "{{ chosen_option }}", because {{ justification }}.

{% if consequences %}
### Consequences

{%- for c in consequences %}
* {{ c.polarity }}, because {{ c.text }}
{%- endfor %}
{% endif %}
{% if confirmation %}
### Confirmation

{{ confirmation }}
{% endif %}
{% if pros_cons %}
## Pros and Cons of the Options

{% for opt in pros_cons %}
### {{ opt.title }}

{% if opt.description %}{{ opt.description }}

{% endif %}{%- for arg in opt.arguments %}
* {{ arg.polarity }}, because {{ arg.text }}
{%- endfor %}
{% endfor %}
{% endif %}
{% if more_information %}
## More Information

{{ more_information }}
{% endif %}
